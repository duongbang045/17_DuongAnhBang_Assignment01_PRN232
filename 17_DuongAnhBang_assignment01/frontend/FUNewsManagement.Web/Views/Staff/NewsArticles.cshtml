@model IEnumerable<FUNewsManagement.Web.Models.NewsArticleDetailViewModel>
@{
    ViewData["Title"] = "News Articles Management";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2><i class="bi bi-journal-text"></i> News Articles Management</h2>
        <p class="text-muted mb-0">Manage all news articles with tags</p>
    </div>
    <div class="d-flex gap-2">
        <form asp-controller="Staff" asp-action="NewsArticles" method="get" class="d-flex gap-2">
            <input type="text" name="keyword" class="form-control" placeholder="Search title/content..." value="@ViewBag.Keyword" />
            <button class="btn btn-outline-primary" type="submit"><i class="bi bi-search"></i></button>
            <a asp-controller="Staff" asp-action="NewsArticles" class="btn btn-outline-secondary"><i class="bi bi-arrow-clockwise"></i></a>
        </form>
        <a asp-controller="Staff" asp-action="CreateNews" class="btn btn-success">
            <i class="bi bi-plus-circle"></i> New Article
        </a>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Headline / Title</th>
                    <th>Category</th>
                    <th>Status</th>
                    <th>Author</th>
                    <th>Created</th>
                    <th>Tags</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var na in Model.OrderByDescending(a => a.CreatedDate))
                    {
                        <tr>
                            <td><span class="badge bg-dark">@na.NewsArticleID</span></td>
                            <td>
                                <div><strong>@na.Headline</strong></div>
                                @if (!string.IsNullOrEmpty(na.NewsTitle) && na.NewsTitle != na.Headline)
                                { <small class="text-muted">@na.NewsTitle</small> }
                            </td>
                            <td><span class="badge bg-info">@(na.CategoryName ?? "N/A")</span></td>
                            <td>
                                @if (na.NewsStatus == true)
                                { <span class="badge bg-success status-active"><i class="bi bi-check-circle"></i> Active</span> }
                                else
                                { <span class="badge bg-danger status-inactive"><i class="bi bi-x-circle"></i> Inactive</span> }
                            </td>
                            <td>@(na.CreatedByName ?? "N/A")</td>
                            <td>@na.CreatedDate?.ToString("MM/dd/yyyy")</td>
                            <td>
                                @if (na.Tags != null && na.Tags.Any())
                                {
                                    @foreach (var t in na.Tags.Take(3))
                                    {
                                        <span class="badge bg-secondary tag-badge">@t.TagName</span>
                                    }
                                    if (na.Tags.Count > 3)
                                    { <span class="badge bg-light text-dark">+@(na.Tags.Count - 3)</span> }
                                }
                                else
                                { <span class="text-muted">-</span> }
                            </td>
                            <td class="text-center">
                                <a asp-controller="Staff" asp-action="UpdateNews" asp-route-id="@na.NewsArticleID" class="btn btn-sm btn-outline-primary">
                                    <i class="bi bi-pencil"></i> Edit
                                </a>
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        data-bs-toggle="modal" data-bs-target="#deleteNewsModal"
                                        data-id="@na.NewsArticleID"
                                        data-headline="@na.Headline">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="8" class="text-center py-5 text-muted"><i class="bi bi-inbox"></i> No news articles found</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteNewsModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-controller="Staff" asp-action="DeleteNews" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="bi bi-exclamation-triangle"></i> Confirm Delete</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="deleteNewsID" name="id" />
                <p class="mb-0">Are you sure you want to delete this news article?</p>
                <div class="mt-3 p-3 bg-light rounded">
                    <strong id="deleteNewsHeadline"></strong>
                </div>
                <div class="alert alert-warning mt-3 mb-0">
                    <i class="bi bi-info-circle"></i> All associated tags will be unlinked automatically.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Yes, Delete</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
const delNewsModal = document.getElementById('deleteNewsModal');
delNewsModal.addEventListener('show.bs.modal', (e) => {
    const btn = e.relatedTarget;
    document.getElementById('deleteNewsID').value = btn.dataset.id;
    document.getElementById('deleteNewsHeadline').textContent = btn.dataset.headline;
});
</script>
}
