@model IEnumerable<FUNewsManagement.Web.Models.Category>
@{
    ViewData["Title"] = "Category Management";
}

<div class="d-flex justify-content-between align-items-center mb-4 flex-wrap gap-2">
    <div>
        <h2><i class="bi bi-folder2-open"></i> Category Management</h2>
        <p class="text-muted mb-0">Manage news categories</p>
    </div>
    <div class="d-flex gap-2">
        <form asp-controller="Staff" asp-action="Categories" method="get" class="d-flex gap-2">
            <input type="text" name="keyword" class="form-control" placeholder="Search by name..." value="@ViewBag.Keyword" />
            <button class="btn btn-outline-primary" type="submit"><i class="bi bi-search"></i></button>
            <a asp-controller="Staff" asp-action="Categories" class="btn btn-outline-secondary"><i class="bi bi-arrow-clockwise"></i></a>
        </form>
        <button type="button" class="btn btn-success" data-bs-toggle="modal" data-bs-target="#createCategoryModal">
            <i class="bi bi-plus-circle"></i> New Category
        </button>
    </div>
</div>

<div class="card shadow-sm">
    <div class="table-responsive">
        <table class="table table-hover mb-0">
            <thead class="table-dark">
                <tr>
                    <th>ID</th>
                    <th>Name</th>
                    <th>Description</th>
                    <th>Parent</th>
                    <th>Status</th>
                    <th class="text-center">Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model != null && Model.Any())
                {
                    @foreach (var cat in Model)
                    {
                        <tr>
                            <td>@cat.CategoryID</td>
                            <td><strong>@cat.CategoryName</strong></td>
                            <td>@cat.CategoryDesciption</td>
                            <td>@(cat.ParentCategoryID.HasValue ? "#" + cat.ParentCategoryID.Value : "-")</td>
                            <td>
                                @if (cat.IsActive == true)
                                { <span class="badge bg-success status-active"><i class="bi bi-check-circle"></i> Active</span> }
                                else
                                { <span class="badge bg-danger status-inactive"><i class="bi bi-x-circle"></i> Inactive</span> }
                            </td>
                            <td class="text-center">
                                <button type="button" class="btn btn-sm btn-outline-primary"
                                        data-bs-toggle="modal" data-bs-target="#editCategoryModal"
                                        data-id="@cat.CategoryID"
                                        data-name="@cat.CategoryName"
                                        data-desc="@cat.CategoryDesciption"
                                        data-parent="@(cat.ParentCategoryID ?? 0)"
                                        data-active="@(cat.IsActive ?? false)">
                                    <i class="bi bi-pencil"></i> Edit
                                </button>
                                <button type="button" class="btn btn-sm btn-outline-danger"
                                        data-bs-toggle="modal" data-bs-target="#deleteCategoryModal"
                                        data-id="@cat.CategoryID"
                                        data-name="@cat.CategoryName">
                                    <i class="bi bi-trash"></i> Delete
                                </button>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr><td colspan="6" class="text-center py-5 text-muted"><i class="bi bi-inbox"></i> No categories found</td></tr>
                }
            </tbody>
        </table>
    </div>
</div>

<!-- Create Modal -->
<div class="modal fade" id="createCategoryModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-controller="Staff" asp-action="CreateCategory" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header bg-success text-white">
                <h5 class="modal-title"><i class="bi bi-folder-plus"></i> Create New Category</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <div class="mb-3">
                    <label class="form-label fw-bold">Category Name <span class="text-danger">*</span></label>
                    <input name="CategoryName" class="form-control" required maxlength="100" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Description <span class="text-danger">*</span></label>
                    <textarea name="CategoryDesciption" class="form-control" required maxlength="250" rows="3"></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Parent Category ID <small class="text-muted">(0 = none)</small></label>
                    <input type="number" name="ParentCategoryID" class="form-control" min="0" value="0" />
                </div>
                <div class="mb-3 form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="createIsActive" name="IsActive" checked value="true" />
                    <label class="form-check-label fw-bold" for="createIsActive">Is Active</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-success"><i class="bi bi-check"></i> Create</button>
            </div>
        </form>
    </div>
</div>

<!-- Edit Modal -->
<div class="modal fade" id="editCategoryModal" tabindex="-1">
    <div class="modal-dialog">
        <form asp-controller="Staff" asp-action="UpdateCategory" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header bg-primary text-white">
                <h5 class="modal-title"><i class="bi bi-pencil-square"></i> Edit Category</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="editCategoryID" name="CategoryID" />
                <div class="mb-3">
                    <label class="form-label fw-bold">Category Name <span class="text-danger">*</span></label>
                    <input id="editCategoryName" name="CategoryName" class="form-control" required maxlength="100" />
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Description <span class="text-danger">*</span></label>
                    <textarea id="editCategoryDesc" name="CategoryDesciption" class="form-control" required maxlength="250" rows="3"></textarea>
                </div>
                <div class="mb-3">
                    <label class="form-label fw-bold">Parent Category ID <small class="text-muted">(0 = none)</small></label>
                    <input type="number" id="editCategoryParent" name="ParentCategoryID" class="form-control" min="0" />
                </div>
                <div class="mb-3 form-check form-switch">
                    <input class="form-check-input" type="checkbox" id="editIsActive" name="IsActive" value="true" />
                    <label class="form-check-label fw-bold" for="editIsActive">Is Active</label>
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-primary"><i class="bi bi-check"></i> Save Changes</button>
            </div>
        </form>
    </div>
</div>

<!-- Delete Modal -->
<div class="modal fade" id="deleteCategoryModal" tabindex="-1">
    <div class="modal-dialog modal-dialog-centered">
        <form asp-controller="Staff" asp-action="DeleteCategory" method="post" class="modal-content">
            @Html.AntiForgeryToken()
            <div class="modal-header bg-danger text-white">
                <h5 class="modal-title"><i class="bi bi-exclamation-triangle"></i> Confirm Delete</h5>
                <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal"></button>
            </div>
            <div class="modal-body">
                <input type="hidden" id="deleteCategoryID" name="id" />
                <p class="mb-0">Are you sure you want to delete category <strong id="deleteCategoryName"></strong>?</p>
                <div class="alert alert-warning mt-3 mb-0">
                    <i class="bi bi-info-circle"></i> Deletion will fail if this category is already used in any news articles.
                </div>
            </div>
            <div class="modal-footer">
                <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">Cancel</button>
                <button type="submit" class="btn btn-danger"><i class="bi bi-trash"></i> Yes, Delete</button>
            </div>
        </form>
    </div>
</div>

@section Scripts {
<script>
const editCatModal = document.getElementById('editCategoryModal');
editCatModal.addEventListener('show.bs.modal', (e) => {
    const btn = e.relatedTarget;
    document.getElementById('editCategoryID').value = btn.dataset.id;
    document.getElementById('editCategoryName').value = btn.dataset.name;
    document.getElementById('editCategoryDesc').value = btn.dataset.desc;
    const pid = btn.dataset.parent;
    document.getElementById('editCategoryParent').value = (pid && pid != 0) ? pid : '';
    document.getElementById('editIsActive').checked = (btn.dataset.active === 'True' || btn.dataset.active === 'true');
});
const delCatModal = document.getElementById('deleteCategoryModal');
delCatModal.addEventListener('show.bs.modal', (e) => {
    const btn = e.relatedTarget;
    document.getElementById('deleteCategoryID').value = btn.dataset.id;
    document.getElementById('deleteCategoryName').textContent = btn.dataset.name;
});
</script>
}
