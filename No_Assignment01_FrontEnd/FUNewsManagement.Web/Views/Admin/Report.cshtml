@model IEnumerable<FUNewsManagement.Web.Models.ReportStatistic>
@{
    ViewData["Title"] = "Report Statistics";
}

<div class="mb-4">
    <h2><i class="bi bi-bar-chart-line-fill"></i> Report Statistics</h2>
    <p class="text-muted mb-0">News articles by category within a date period</p>
</div>

<div class="card shadow-sm mb-4">
    <div class="card-body">
        <form asp-controller="Admin" asp-action="Report" method="get" class="row g-3 align-items-end">
            <div class="col-md-4">
                <label class="form-label fw-bold">Start Date</label>
                <input type="date" name="startDate" class="form-control form-control-lg" value="@ViewBag.StartDate" />
            </div>
            <div class="col-md-4">
                <label class="form-label fw-bold">End Date</label>
                <input type="date" name="endDate" class="form-control form-control-lg" value="@ViewBag.EndDate" />
            </div>
            <div class="col-md-4">
                <button type="submit" class="btn btn-primary btn-lg w-100"><i class="bi bi-funnel"></i> Generate Report</button>
            </div>
        </form>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
        <h5 class="mb-0"><i class="bi bi-table"></i> Report Results</h5>
        <span class="badge bg-light text-dark">Period: @ViewBag.StartDate to @ViewBag.EndDate</span>
    </div>
    <div class="card-body">
        @if (Model != null && Model.Any())
        {
            var total = Model.Sum(r => r.NewsCount);
            <div class="row mb-4">
                <div class="col-md-4">
                    <div class="bg-primary text-white rounded p-3 text-center">
                        <h3 class="mb-0">@total</h3>
                        <small>Total News Articles</small>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="bg-success text-white rounded p-3 text-center">
                        <h3 class="mb-0">@Model.Count()</h3>
                        <small>Categories Used</small>
                    </div>
                </div>
                <div class="col-md-4">
                    <div class="bg-info text-white rounded p-3 text-center">
                        <h3 class="mb-0">@(total > 0 && Model.Any() ? Math.Round((double)total / Model.Count(), 1) : 0)</h3>
                        <small>Avg per Category</small>
                    </div>
                </div>
            </div>

            <div class="table-responsive">
                <table class="table table-hover table-striped mb-0">
                    <thead class="table-dark">
                        <tr>
                            <th>Rank</th>
                            <th>Category Name</th>
                            <th class="text-center">News Count</th>
                            <th>Percentage</th>
                            <th>Visual</th>
                        </tr>
                    </thead>
                    <tbody>
                        @{ int rank = 1; }
                        @foreach (var item in Model)
                        {
                            var pct = total > 0 ? Math.Round((double)item.NewsCount / total * 100, 1) : 0;
                            <tr>
                                <td>
                                    @if (rank == 1)
                                    { <i class="bi bi-trophy-fill text-warning fs-5"></i> }
                                    else if (rank == 2)
                                    { <i class="bi bi-trophy-fill text-secondary fs-5"></i> }
                                    else if (rank == 3)
                                    { <i class="bi bi-trophy-fill text-danger fs-5"></i> }
                                    else
                                    { <span class="badge bg-secondary">#@rank</span> }
                                </td>
                                <td><strong>@item.CategoryName</strong></td>
                                <td class="text-center"><span class="badge bg-primary fs-6">@item.NewsCount</span></td>
                                <td>@pct%</td>
                                <td>
                                    <div class="progress" style="height: 24px;">
                                        <div class="progress-bar bg-success progress-bar-striped" style="width: @pct%">
                                            @pct%
                                        </div>
                                    </div>
                                </td>
                            </tr>
                            rank++;
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted">
                <i class="bi bi-graph-down display-1"></i>
                <h4 class="mt-3">No data for selected period</h4>
                <p>Try adjusting the date range.</p>
            </div>
        }
    </div>
</div>
