@model IEnumerable<FUNewsManagement.Web.Models.NewsArticleDetailViewModel>
@{
    ViewData["Title"] = "Home - News";
}

<div class="row mb-4">
    <div class="col-12">
        <div class="p-4 bg-primary text-white rounded mb-4">
            <h1><i class="bi bi-newspaper"></i> FU University News</h1>
            <p class="lead mb-0">Stay updated with the latest news from FU University</p>
        </div>
        <form asp-controller="Home" asp-action="Index" method="get" class="mb-4">
            <div class="input-group">
                <input type="text" name="keyword" class="form-control form-control-lg" placeholder="Search news articles..." value="@ViewBag.Keyword" />
                <button class="btn btn-primary btn-lg" type="submit"><i class="bi bi-search"></i> Search</button>
                <a asp-controller="Home" asp-action="Index" class="btn btn-outline-secondary btn-lg">Reset</a>
            </div>
        </form>
    </div>
</div>

@if (Model != null && Model.Any())
{
    <div class="row g-4">
        @foreach (var article in Model.OrderByDescending(a => a.CreatedDate))
        {
            <div class="col-md-6 col-lg-4">
                <div class="card news-card h-100 shadow-sm">
                    <div class="card-body d-flex flex-column">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <span class="badge bg-info"><i class="bi bi-folder"></i> @(article.CategoryName ?? "Uncategorized")</span>
                            <small class="text-muted">@article.CreatedDate?.ToString("MMM dd, yyyy")</small>
                        </div>
                        <h5 class="card-title">@article.Headline</h5>
                        @if (!string.IsNullOrEmpty(article.NewsTitle) && article.NewsTitle != article.Headline)
                        {
                            <h6 class="card-subtitle mb-2 text-muted">@article.NewsTitle</h6>
                        }
                        <p class="card-text flex-grow-1">
                            @if (article.NewsContent != null && article.NewsContent.Length > 150)
                            {
                                @article.NewsContent.Substring(0, 150)<text>...</text>
                            }
                            else
                            {
                                @article.NewsContent
                            }
                        </p>
                        @if (article.Tags != null && article.Tags.Any())
                        {
                            <div class="mb-3">
                                @foreach (var tag in article.Tags)
                                {
                                    <span class="badge bg-secondary tag-badge"><i class="bi bi-tag"></i> @tag.TagName</span>
                                }
                            </div>
                        }
                        <div class="d-flex justify-content-between align-items-center mt-auto">
                            <small class="text-muted">By @(article.CreatedByName ?? "Unknown")</small>
                            <a asp-controller="Home" asp-action="Details" asp-route-id="@article.NewsArticleID" class="btn btn-sm btn-outline-primary">
                                Read more <i class="bi bi-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else
{
    <div class="text-center py-5 bg-light rounded">
        <i class="bi bi-inbox display-1 text-muted"></i>
        <h3 class="text-muted mt-3">No news articles found</h3>
    </div>
}
