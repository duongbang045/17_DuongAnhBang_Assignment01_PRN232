@model FUNewsManagement.Web.Models.NewsArticleCreateViewModel
@{
    ViewData["Title"] = "Create News Article";
}

<div class="mb-4">
    <a asp-controller="Staff" asp-action="NewsArticles" class="btn btn-outline-secondary mb-3">
        <i class="bi bi-arrow-left"></i> Back to News Articles
    </a>
    <h2><i class="bi bi-journal-plus"></i> Create News Article</h2>
    <p class="text-muted mb-0">Fill in the details below to create a new news article</p>
</div>

<form asp-controller="Staff" asp-action="CreateNews" method="post">
    @Html.AntiForgeryToken()
    <div asp-validation-summary="All" class="text-danger mb-3"></div>
    <div class="row">
        <div class="col-lg-8">
            <div class="card shadow-sm mb-4">
                <div class="card-body p-4">
                    <div class="mb-3">
                        <label class="form-label fw-bold">Article ID (auto-generated)</label>
                        <input asp-for="NewsArticleID" class="form-control" readonly />
                        <span asp-validation-for="NewsArticleID" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="Headline" class="form-label fw-bold">Headline <span class="text-danger">*</span></label>
                        <input asp-for="Headline" class="form-control form-control-lg" maxlength="150" />
                        <span asp-validation-for="Headline" class="text-danger small"></span>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewsTitle" class="form-label fw-bold">News Title</label>
                        <input asp-for="NewsTitle" class="form-control" maxlength="400" />
                        <span asp-validation-for="NewsTitle" class="text-danger small"></span>
                    </div>
                    <div class="mb-0">
                        <label asp-for="NewsContent" class="form-label fw-bold">News Content <span class="text-danger">*</span></label>
                        <textarea asp-for="NewsContent" class="form-control" rows="12" maxlength="4000" style="white-space: pre-line;"></textarea>
                        <span asp-validation-for="NewsContent" class="text-danger small"></span>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-lg-4">
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-primary text-white"><h5 class="mb-0"><i class="bi bi-sliders"></i> Settings</h5></div>
                <div class="card-body">
                    <div class="mb-3">
                        <label asp-for="CreatedDate" class="form-label fw-bold">Created Date</label>
                        <input asp-for="CreatedDate" type="datetime-local" class="form-control" />
                    </div>
                    <div class="mb-3">
                        <label asp-for="CategoryID" class="form-label fw-bold">Category</label>
                        <select asp-for="CategoryID" class="form-select">
                            <option value="">-- Select Category --</option>
                            @if (Model.Categories != null)
                            {
                                @foreach (var c in Model.Categories.Where(c => c.IsActive == true))
                                {
                                    <option value="@c.CategoryID">@c.CategoryName</option>
                                }
                            }
                        </select>
                    </div>
                    <div class="mb-3">
                        <label asp-for="NewsSource" class="form-label fw-bold">News Source</label>
                        <input asp-for="NewsSource" class="form-control" maxlength="400" />
                    </div>
                    <div class="mb-0 form-check form-switch">
                        <input class="form-check-input" type="checkbox" asp-for="NewsStatus" id="newsStatus" />
                        <label class="form-check-label fw-bold" for="newsStatus">Publish (Active)</label>
                    </div>
                </div>
            </div>
            <div class="card shadow-sm mb-4">
                <div class="card-header bg-secondary text-white"><h5 class="mb-0"><i class="bi bi-tags"></i> Tags</h5></div>
                <div class="card-body" style="max-height: 300px; overflow-y: auto;">
                    @if (Model.Tags != null && Model.Tags.Any())
                    {
                        <div class="row g-2">
                            @{ int tagIdx = 0; }
                            @foreach (var tag in Model.Tags)
                            {
                                <div class="col-12">
                                    <div class="form-check border rounded p-2">
                                        <input class="form-check-input" type="checkbox"
                                               id="tag_@tagIdx" value="@tag.TagID" name="TagIds" />
                                        <label class="form-check-label" for="tag_@tagIdx">
                                            <strong>@tag.TagName</strong>
                                            @if (!string.IsNullOrEmpty(tag.Note))
                                            { <small class="text-muted d-block">@tag.Note</small> }
                                        </label>
                                    </div>
                                </div>
                                tagIdx++;
                            }
                        </div>
                    }
                    else
                    {
                        <p class="text-muted mb-0">No tags available.</p>
                    }
                </div>
            </div>
            <div class="d-flex gap-2">
                <a asp-controller="Staff" asp-action="NewsArticles" class="btn btn-secondary w-100">Cancel</a>
                <button type="submit" class="btn btn-success w-100"><i class="bi bi-save"></i> Save</button>
            </div>
        </div>
    </div>
</form>
